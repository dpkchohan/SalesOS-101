modules = ["nodejs-24", "python-3.11", "postgresql-16"]
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-migrate-alert"

[[workflows.workflow]]
name = "test-migrate-alert"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh scripts/test-migrate-and-start.sh"

[workflows.workflow.metadata]
isValidation = true
[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 19090
externalPort = 3002

[[ports]]
localPort = 22314
externalPort = 3000
[userenv]
[userenv.shared]
[nix]
channel = "stable-25_05"
